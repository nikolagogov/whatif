---
import { articleRoute } from '../../lib/routes';
import type { ArticleRelatedProps } from '../../types/article';
import ArticleCard from '../ArticleCard.astro';

type Props = ArticleRelatedProps;

const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <div class="exploration-block">
    <h3>Related</h3>
    <div class="exploration-grid">
      {items.map((rel) => (
        <ArticleCard
          href={articleRoute(rel.sector, rel.id)}
          image={rel.data.image}
          title={rel.data.title}
          sector={rel.sector}
        />
      ))}
    </div>
  </div>
)}
