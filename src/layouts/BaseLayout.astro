---
import { articleRoute } from '../lib/routes';
import '../styles/index.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const searchCollections = await Promise.all([
  getCollection('history'),
  getCollection('science'),
  getCollection('space'),
  getCollection('society'),
]);
const headerSearchData = searchCollections.flat().map((post) => ({
  title: post.data.title,
  description: post.data.description,
  sector: post.collection.charAt(0).toUpperCase() + post.collection.slice(1),
  url: articleRoute(post.collection, post.id),
  tags: post.data.tags || [],
  topics: post.data.topics || [],
}));

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
}

const {
  title,
  description = 'Had It Gone explores alternate history, speculative science, and cosmic scenarios — what if the world had taken another path?',
  image = '/og-image.png',
  url,
  type = 'website',
} = Astro.props;

const currentSector = Astro.url.pathname.split('/')[1] || '';
const isDiscoverActive = ['content', 'history', 'science', 'space', 'society', 'latest'].includes(currentSector);
const isExploreActive = ['explore', 'timeline', 'branches', 'compare', 'causality', 'world', 'world-graph'].includes(currentSector);
const siteUrl = Astro.site ?? new URL('https://whatif-portal.netlify.app');
const absoluteImage = new URL(image, siteUrl).href;
const absoluteUrl = url
  ? new URL(url, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl} />
    <link rel="alternate" type="application/rss+xml" title="Had It Gone" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Had It Gone" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
  </head>

  <body>
    {type === 'article' && <div class="reading-progress" id="readingProgress"></div>}

    <SiteHeader pathname={Astro.url.pathname} searchData={headerSearchData} />

    <div class:list={['page-frame', Astro.url.pathname === '/' && 'platform-page-frame']}>
      <slot />
    </div>

    <SiteFooter />

    <button class="back-to-top" id="backToTop" aria-label="Back to top">↑</button>


  </body>
</html>