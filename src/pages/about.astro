---
import { ROUTES } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BackToHomepage from '../components/BackToHomepage.astro';
---

<BaseLayout
  title="About | Had It Gone"
  description="What Had It Gone is and what you will find here."
  url={ROUTES.about}
  type="website"
>
  <div class="about-page">
    <PageHeader title="About Had It Gone" />

    <p>
      <em>Had It Gone</em> is a collection of alternate history, speculative
      science, and cosmic scenarios. Each article takes a turning point — a
      battle, a discovery, a decision — and follows it forward to see where
      it leads.
    </p>

    <h2>What You Will Find</h2>

    <ul>
      <li>
        <strong>🏛️ Alternate History</strong> — pivotal moments where the
        past could have gone another way.
      </li>
      <li>
        <strong>🧪 Speculative Science</strong> — changes to biology,
        evolution, and the natural world.
      </li>
      <li>
        <strong>🌌 Cosmic Shifts</strong> — altered physics and celestial
        scenarios.
      </li>
      <li>
        <strong>🌍 Society &amp; Geopolitics</strong> — how different social
        and political structures could have shaped the modern world.
      </li>
    </ul>

    <h2>Contact</h2>

    <p>
      📧 <a href="mailto:hello@haditgone.com">hello@haditgone.com</a>
    </p>

    <div class="back-links">
  <BackToHomepage />
</div>
  </div>
</BaseLayout>