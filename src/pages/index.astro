---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const historyPosts = await getCollection('history');
const sciencePosts = await getCollection('science');
const spacePosts = await getCollection('space');
const societyPosts = await getCollection('society');

function getLatest(posts: any[]) {
  return [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
}

function getFeatured(posts: any[]) {
  return posts.find((post: any) => post.data.featured === true) || getLatest(posts);
}

const historyFeatured = getFeatured(historyPosts);
const historyLatest = getLatest(historyPosts);
const scienceFeatured = getFeatured(sciencePosts);
const scienceLatest = getLatest(sciencePosts);
const spaceFeatured = getFeatured(spacePosts);
const spaceLatest = getLatest(spacePosts);
const societyFeatured = getFeatured(societyPosts);
const societyLatest = getLatest(societyPosts);

const allPosts = [
  ...historyPosts.map(p => ({ ...p, sector: 'History', sectorSlug: 'history' })),
  ...sciencePosts.map(p => ({ ...p, sector: 'Science', sectorSlug: 'science' })),
  ...spacePosts.map(p => ({ ...p, sector: 'Space', sectorSlug: 'space' })),
  ...societyPosts.map(p => ({ ...p, sector: 'Society', sectorSlug: 'society' })),
];

const recentPosts = [...allPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const searchData = allPosts.map(p => ({
  title: p.data.title,
  description: p.data.description,
  sector: p.sector,
  url: `/${p.sectorSlug}/${p.id}`,
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>The What-If Portal | Multi-Sector Speculative Hub</title>
	</head>
	<body>
		<nav>
			<a href="/" class="logo">What If <span>Hub</span></a>
			<ul class="nav-links">
				<li><a href="/history">🏛️ History</a></li>
				<li><a href="/science">🧪 Science</a></li>
				<li><a href="/space">🌌 Space</a></li>
				<li><a href="/society">🌍 Society</a></li>
			</ul>
		</nav>

		<div class="page-frame">
			<div class="home-layout">
				<div class="main-content">
					<div class="hero-portal">
						<h1>The What-If Portal</h1>
						<p>A master database of alternate timelines, speculative sciences, and cosmic shifts.</p>
					</div>

					<div class="search-box">
						<span class="search-icon">🔍</span>
						<input type="text" id="searchInput" placeholder="Search articles..." />
					</div>

					<div class="search-results" id="searchResults">
						<div class="search-results-list" id="searchResultsList"></div>
					</div>

					<div class="banner">
						<div class="banner-inner">
							<p>"History is written by the victors. But what if there were no victors?"</p>
							<div class="banner-author">— The What-If Portal</div>
						</div>
					</div>

					<!-- HISTORY -->
					<div class="sector-wrap">
						<a href="/history" class="sector-hero">
							<div class="sector-hero-img" style="background-image: url('/images/sector-history.jpg');"></div>
							<div class="sector-hero-body">
								<h2>🏛️ Alternate History</h2>
								<p>Analyzing key turning points in human history.</p>
								<div class="sector-hero-actions">
									<span class="explore-btn">Explore History →</span>
									<span class="sector-count">{historyPosts.length} articles</span>
								</div>
							</div>
						</a>
						<div class="sector-subcards">
							<a href={`/history/${historyFeatured.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${historyFeatured.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label featured">★ Featured</span>
									<div class="subcard-title">{historyFeatured.data.title}</div>
								</div>
							</a>
							<a href={`/history/${historyLatest.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${historyLatest.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label latest">⏱ Latest</span>
									<div class="subcard-title">{historyLatest.data.title}</div>
								</div>
							</a>
						</div>
					</div>

					<!-- SCIENCE -->
					<div class="sector-wrap">
						<a href="/science" class="sector-hero">
							<div class="sector-hero-img" style="background-image: url('/images/sector-science.jpg');"></div>
							<div class="sector-hero-body">
								<h2>🧪 Speculative Science</h2>
								<p>Altering the fundamental biology, physics, and evolution of our planet.</p>
								<div class="sector-hero-actions">
									<span class="explore-btn">Explore Science →</span>
									<span class="sector-count">{sciencePosts.length} articles</span>
								</div>
							</div>
						</a>
						<div class="sector-subcards">
							<a href={`/science/${scienceFeatured.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${scienceFeatured.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label featured">★ Featured</span>
									<div class="subcard-title">{scienceFeatured.data.title}</div>
								</div>
							</a>
							<a href={`/science/${scienceLatest.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${scienceLatest.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label latest">⏱ Latest</span>
									<div class="subcard-title">{scienceLatest.data.title}</div>
								</div>
							</a>
						</div>
					</div>

					<!-- SPACE -->
					<div class="sector-wrap">
						<a href="/space" class="sector-hero">
							<div class="sector-hero-img" style="background-image: url('/images/sector-space.jpg');"></div>
							<div class="sector-hero-body">
								<h2>🌌 Cosmic Shifts</h2>
								<p>Exploring celestial alterations in our solar system.</p>
								<div class="sector-hero-actions">
									<span class="explore-btn">Explore Space →</span>
									<span class="sector-count">{spacePosts.length} articles</span>
								</div>
							</div>
						</a>
						<div class="sector-subcards">
							<a href={`/space/${spaceFeatured.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${spaceFeatured.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label featured">★ Featured</span>
									<div class="subcard-title">{spaceFeatured.data.title}</div>
								</div>
							</a>
							<a href={`/space/${spaceLatest.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${spaceLatest.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label latest">⏱ Latest</span>
									<div class="subcard-title">{spaceLatest.data.title}</div>
								</div>
							</a>
						</div>
					</div>

					<!-- SOCIETY -->
					<div class="sector-wrap">
						<a href="/society" class="sector-hero">
							<div class="sector-hero-img" style="background-image: url('/images/sector-society.jpg');"></div>
							<div class="sector-hero-body">
								<h2>🌍 Society &amp; Geopolitics</h2>
								<p>Exploring how social structures and political decisions shape our world.</p>
								<div class="sector-hero-actions">
									<span class="explore-btn">Explore Society →</span>
									<span class="sector-count">{societyPosts.length} articles</span>
								</div>
							</div>
						</a>
						<div class="sector-subcards">
							<a href={`/society/${societyFeatured.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${societyFeatured.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label featured">★ Featured</span>
									<div class="subcard-title">{societyFeatured.data.title}</div>
								</div>
							</a>
							<a href={`/society/${societyLatest.id}`} class="subcard">
								<div class="subcard-img" style={`background-image: url('${societyLatest.data.image}');`}></div>
								<div class="subcard-body">
									<span class="subcard-label latest">⏱ Latest</span>
									<div class="subcard-title">{societyLatest.data.title}</div>
								</div>
							</a>
						</div>
					</div>
				</div>

				<aside class="sidebar">
					<div class="sidebar-box">
						<h3 class="sidebar-title">📚 Sectors</h3>
						<ul class="sidebar-list">
							<li><a href="/history">🏛️ History <span class="count">{historyPosts.length}</span></a></li>
							<li><a href="/science">🧪 Science <span class="count">{sciencePosts.length}</span></a></li>
							<li><a href="/space">🌌 Space <span class="count">{spacePosts.length}</span></a></li>
							<li><a href="/society">🌍 Society <span class="count">{societyPosts.length}</span></a></li>
						</ul>
					</div>

					<div class="sidebar-box">
						<h3 class="sidebar-title">🆕 Recently Added</h3>
						{recentPosts.map(post => (
							<a href={`/${post.sectorSlug}/${post.id}`} class="recent-item">
								<span class="recent-sector">{post.sector}</span>
								<div class="recent-title">{post.data.title}</div>
							</a>
						))}
					</div>

					<div class="sidebar-cta">
						<h3>Explore the Unknown</h3>
						<p>Dive into alternate timelines and cosmic possibilities.</p>
					</div>
				</aside>
			</div>

			<footer class="site-footer">
				<div class="footer-logo">What If <span>Hub</span></div>
				<ul class="footer-links">
					<li><a href="/">Home</a></li>
					<li><a href="/history">History</a></li>
					<li><a href="/science">Science</a></li>
					<li><a href="/space">Space</a></li>
					<li><a href="/society">Society</a></li>
				</ul>
				<p class="footer-copy">© 2026 The What-If Portal. All rights reserved.</p>
			</footer>
		</div>

		<script define:vars={{ searchData }}>
			const input = document.getElementById('searchInput');
			const results = document.getElementById('searchResults');
			const list = document.getElementById('searchResultsList');

			input.addEventListener('input', (e) => {
				const query = e.target.value.toLowerCase().trim();

				if (query.length < 2) {
					results.classList.remove('active');
					return;
				}

				const matches = searchData.filter(post =>
					post.title.toLowerCase().includes(query) ||
					post.description.toLowerCase().includes(query)
				);

				if (matches.length === 0) {
					list.innerHTML = '<div class="search-empty">No articles found.</div>';
				} else {
					list.innerHTML = matches.slice(0, 8).map(post => `
						<a href="${post.url}" class="search-result-item">
							<span class="sector-tag">${post.sector}</span>
							<h4>${post.title}</h4>
							<p>${post.description}</p>
						</a>
					`).join('');
				}

				results.classList.add('active');
			});
		</script>
	</body>
</html>