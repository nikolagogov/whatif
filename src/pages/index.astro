---
import { ROUTES } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="HAD IT GONE | What If History Had Turned Differently?"
  description="Speculative history, alternate science, and cosmic scenarios — grounded in research, driven by curiosity."
>
  <main class="platform-portal">
    <div class="portal-backdrop" aria-hidden="true"></div>

    <section class="portal-content" aria-labelledby="portal-tagline">
      
      <img
        class="brand-logo"
        src="/logo-portal.png"
        alt="HAD IT GONE"
        width="1963"
        height="559"
        fetchpriority="high"
      />

      <h1 id="portal-tagline">What if the world had taken another path?</h1>

      <p class="description">
        Speculative history, alternate science, and cosmic scenarios —
        grounded in research, driven by curiosity.
      </p>

      <nav class="portal-choices" aria-label="Choose how to enter HAD IT GONE">
        <a class="portal-choice portal-choice--content" href={ROUTES.content}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 5.5c5-2.4 9.2-1.5 13 2.1v20c-3.8-3.6-8-4.5-13-2.1zM29 5.5c-5-2.4-9.2-1.5-13 2.1v20c3.8-3.6 8-4.5 13-2.1z" />
          </svg>
          <span class="portal-choice-copy">
            <strong>Discover Alternative Paths</strong>
            <span>Stories, articles and possibilities</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <a class="portal-choice portal-choice--explore" href={ROUTES.explore}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="11.5" />
            <path d="M4.8 16h22.4M16 4.5c3.2 3.1 4.8 6.9 4.8 11.5S19.2 24.4 16 27.5C12.8 24.4 11.2 20.6 11.2 16S12.8 7.6 16 4.5Z" />
          </svg>
          <span class="portal-choice-copy">
            <strong>Explore Worlds &amp; Timeline</strong>
            <span>Discover alternate worlds and trace their turning points</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </nav>

      <p class="closing">
        <span class="closing-line"></span>
        <span class="closing-text">
          <span>EXPLORE THE WORLDS THAT</span>
          <strong>ALMOST</strong>
          <span>WERE.</span>
        </span>
        <span class="closing-line"></span>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .platform-portal {
    --gold: #e8b75f;
    --gold-light: #f3c878;

    position: relative;
    isolation: isolate;
    display: flex;
    box-sizing: border-box;

    width: 100%;
    height: 100dvh;
    min-height: 0;

    margin-left: calc(50% - 50vw);
    margin-top: 0;
    margin-bottom: 0;

    overflow: hidden;
    align-items: stretch;
    justify-content: center;

    color: #f5f4f0;
    background: #061522;
  }

  .portal-backdrop {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(3 14 24 / 8%) 0%,
        rgb(3 14 24 / 2%) 50%,
        rgb(3 12 21 / 10%) 100%
      ),
      url('/images/platform-hero-background.png') center center / cover no-repeat;
  }

  .portal-content {
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: clamp(220px, 29vh, 250px) 24px 12px;
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 0 12px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .19em;
    line-height: 1.5;
  }

  .eyebrow span {
    width: 24px;
    height: 1px;
    flex-shrink: 0;
    background: var(--gold);
  }

  /* Use the original logo file, including its original branching design. */
  .brand-logo {
    display: block;
    width: min(60vw, 900px);
    max-height: 230px;
    height: auto;
    margin-top: 0;
    flex-shrink: 0;
    object-fit: contain;
    filter: drop-shadow(0 2px 12px rgb(0 0 0 / 15%));
  }

  #portal-tagline {
    margin: 10px 0 0;
    color: var(--gold-light);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(23px, 2.1vw, 32px);
    font-style: italic;
    font-weight: 500;
    line-height: 1.2;
    text-shadow: 0 2px 18px rgb(0 0 0 / 30%);
  }

  .description {
    max-width: 900px;
    margin: 10px 0 0;
    color: #f0f3f7;
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.6;
    text-shadow: 0 2px 10px rgb(0 0 0 / 75%);
  }

  /* Search sits alongside the existing navigation's Dark control. */
  .header-search {
    position: fixed;
    z-index: 100;
    top: 11px;
    right: 195px;
    box-sizing: border-box;
    display: flex;
    width: clamp(210px, 18vw, 320px);
    height: 39px;
    align-items: center;
    gap: 10px;
    padding: 0 13px;
    border: 1px solid rgb(222 232 242 / 30%);
    border-radius: 24px;
    background: rgb(5 19 30 / 88%);
    box-shadow: 0 3px 12px rgb(0 0 0 / 12%);
    backdrop-filter: blur(8px);
  }

  .header-search:focus-within {
    border-color: var(--gold);
  }

  .header-search svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    fill: none;
    stroke: #f3f5f8;
    stroke-width: 1.8;
  }

  .header-search input {
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 13px;
  }

  .header-search input::placeholder {
    color: #e1e7ee;
    opacity: 1;
  }

  .portal-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 1040px);
    gap: 18px;
    margin-top: auto;
    margin-bottom: clamp(72px, 11vh, 104px);
  }

  .portal-choice {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 20px;
    min-height: 82px;
    align-items: center;
    gap: 15px;
    padding: 15px 22px;
    border: 1px solid #ffe0a0;
    border-radius: 14px;
    background: linear-gradient(135deg, #f6d18a, #e5ad4c);
    box-shadow:
      0 5px 24px rgb(0 0 0 / 25%),
      inset 0 1px 0 rgb(255 255 255 / 50%);
    color: #101720;
    text-align: left;
    text-decoration: none;
    transition: transform 160ms ease, filter 160ms ease, border-color 160ms ease;
  }

  .portal-choice:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
  }

  .portal-choice--explore {
    border-color: #75d9f2;
    background: linear-gradient(135deg, #087da8 0%, #08658f 52%, #064b73 100%);
    color: #ffffff;
    box-shadow:
      0 5px 26px rgb(0 0 0 / 30%),
      0 0 20px rgb(22 164 210 / 22%),
      inset 0 1px 0 rgb(255 255 255 / 24%);
  }

  .portal-choice svg {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .portal-choice-copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .portal-choice-copy strong {
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 800;
    line-height: 1.25;
  }

  .portal-choice-copy > span {
    color: rgb(16 23 32 / 76%);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
  }

  .portal-choice--explore .portal-choice-copy > span {
    color: #e0f5fc;
  }

  .portal-choice--explore:hover {
    border-color: #a4edff;
    filter: brightness(1.09);
    box-shadow:
      0 8px 30px rgb(0 0 0 / 32%),
      0 0 26px rgb(22 164 210 / 32%),
      inset 0 1px 0 rgb(255 255 255 / 28%);
  }

  .portal-choice .arrow {
    justify-self: end;
    font-size: 26px;
    font-weight: 400;
  }

  .closing {
  display: flex;
  width: min(100%, 1250px);
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 18px;
  margin: 0 0 40px;
  color: #e7ebf1;
  font-size: 12px;
  letter-spacing: 0.18em;
  line-height: 1.7;
  white-space: nowrap;
  text-shadow: 0 2px 10px #00101c;
}

  .closing-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
  }

  .closing-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, var(--gold));
  }

  .closing-line:last-child {
    transform: rotate(180deg);
  }

  .closing strong {
    color: var(--gold-light);
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (min-width: 1500px) {
    .portal-content {
      padding-top: 34px;
    }

    .brand-logo {
      width: min(60vw, 900px);
      max-height: 230px;
    }
  }

  @media (max-height: 800px) and (min-width: 701px) {
    .portal-content {
      padding-top: 20px;
      padding-bottom: 12px;
    }

    .eyebrow {
      margin-bottom: 7px;
    }

    .brand-logo {
      width: min(60vw, 900px);
      max-height: 230px;
    }

    #portal-tagline {
      font-size: clamp(23px, 2.1vw, 32px);
    }

    .description {
      margin-top: 8px;
    }

    .portal-choices {
      margin-bottom: clamp(64px, 10vh, 90px);
    }

    .portal-choice {
      min-height: 74px;
    }

    .closing {
      margin-bottom: 30px;
      font-size: 12px;
    }
  }

  @media (max-width: 1250px) {
    .header-search {
      right: 175px;
      width: 210px;
    }
  }

  @media (max-width: 1000px) {
    .header-search {
      display: none;
    }

    .portal-content {
      justify-content: flex-start;
    }

    .portal-choices {
      margin-top: 32px;
      margin-bottom: 32px;
    }

    .closing {
      margin-top: auto;
      white-space: normal;
    }
  }

  @media (max-width: 700px) {
    .platform-portal,
    .portal-content {
      min-height: calc(100svh - 62px);
    }

    .portal-backdrop {
      background-position: center center;
    }

    .portal-content {
      padding: 36px 20px 18px;
    }

    .eyebrow {
      max-width: 100%;
      margin-bottom: 16px;
      gap: 8px;
      font-size: 9px;
      letter-spacing: .1em;
    }

    .eyebrow span {
      width: 13px;
    }

    .brand-logo {
      width: min(100%, 560px);
      max-height: 115px;
    }

    #portal-tagline {
      margin-top: 17px;
      font-size: clamp(25px, 2.5vw, 36px);
    }

    .description {
      max-width: 450px;
      margin-top: 13px;
      font-size: 14px;
    }

    .portal-choices {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin-top: auto;
      margin-bottom: 26px;
    }

    .portal-choice {
      min-height: 62px;
      grid-template-columns: 28px minmax(0, 1fr) 18px;
      gap: 12px;
      padding: 11px 15px;
      border-radius: 11px;
    }

    .portal-choice svg {
      width: 26px;
      height: 26px;
    }

    .portal-choice-copy strong {
      font-size: 14px;
    }

    .portal-choice-copy > span {
      font-size: 10px;
    }

    .portal-choice .arrow {
      font-size: 22px;
    }

    .closing {
      gap: 10px;
      font-size: 8px;
      letter-spacing: .12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-choice {
      transition: none;
    }
  }
  :global(html),
:global(body) {
  margin-top: 0;
}

:global(body:has(.platform-portal)) {
  padding-top: 0 !important;
}

:global(body:has(.platform-portal) main) {
  margin-top: 0 !important;
}

.platform-portal {
  margin-top: -1px;
}
</style>