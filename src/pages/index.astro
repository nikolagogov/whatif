---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import spotlight from '../data/spotlight.json';
import { sortPosts } from '../lib/sorting';

const historyArticles = await getCollection('history');
const scienceArticles = await getCollection('science');
const spaceArticles = await getCollection('space');
const societyArticles = await getCollection('society');

type SectorKey = 'history' | 'science' | 'space' | 'society';

const all = [
  ...historyArticles.map(a => ({ ...a, sector: 'history' as const, sectorLabel: 'History', emoji: '🏛️' })),
  ...scienceArticles.map(a => ({ ...a, sector: 'science' as const, sectorLabel: 'Science', emoji: '🔬' })),
  ...spaceArticles.map(a => ({ ...a, sector: 'space' as const, sectorLabel: 'Space', emoji: '🚀' })),
  ...societyArticles.map(a => ({ ...a, sector: 'society' as const, sectorLabel: 'Society', emoji: '🌍' })),
];

const sorted = sortPosts(all);

// Spotlight: търси по id (slug), после по title, после fallback към най-новата
const homeKey = typeof spotlight.home === 'string' ? spotlight.home : '';
const homeSpotlight =
  sorted.find(a => a.id === homeKey) ||
  sorted.find(a => a.data.title === homeKey) ||
  sorted[0];

// Latest: 3 най-нови, БЕЗ Cover Story (за да не се дублира)
const latest3 = sorted
  .filter(a => a.id !== homeSpotlight?.id)
  .slice(0, 3);

// Всички статии — за Surprise Me (избира от целия archive)
const allArticles = sorted.map(a => ({
  url: `/${a.sector}/${a.id}`,
  title: a.data.title,
}));

const exploreSectors: {
  key: SectorKey;
  label: string;
  emoji: string;
  accent: string;
  img: string;
}[] = [
  { key: 'history', label: 'History', emoji: '🏛️', accent: 'The world that was', img: '/images/sectors/history.jpg' },
  { key: 'science', label: 'Science', emoji: '🔬', accent: 'The world that could be', img: '/images/sectors/science.jpg' },
  { key: 'space',   label: 'Space',   emoji: '🚀', accent: 'The world beyond',     img: '/images/sectors/space.jpg' },
  { key: 'society', label: 'Society', emoji: '🌍', accent: 'The world we build',  img: '/images/sectors/society.jpg' },
];

const counts: Record<SectorKey, number> = {
  history: historyArticles.length,
  science: scienceArticles.length,
  space: spaceArticles.length,
  society: societyArticles.length,
};

// Fallback title (ако статията няма coverTitleLines)
const coverTitle = homeSpotlight.data.title.replace(/^What If\s+/i, '');
---

<BaseLayout title="Had It Gone — What If History Had Turned Differently?">
  <div class="home-page">

    <!-- MASTHEAD -->
    <section class="masthead">
      <div class="masthead-logo">
        <img src="/logo-light.png" alt="Had It Gone" class="logo-light" />
        <img src="/logo-dark.png" alt="Had It Gone" class="logo-dark" />
      </div>
      <p class="masthead-tagline">What if history had turned differently?</p>
      <p class="masthead-sub">
        Speculative history, alternate science, and cosmic scenarios — grounded in research, driven by curiosity.
      </p>
    </section>

    <!-- SEARCH -->
    <section class="home-search">
      <a href="/search" class="home-search-link">
        <span>Search the archive</span>
        <span class="home-search-icon">⌕</span>
      </a>
    </section>

    <!-- COVER STORY -->
    {homeSpotlight && (
      <section class="cover-story">
        <div class="cover-story-header">
          <span class="cover-story-label">Cover Story</span>
        </div>
        <a href={`/${homeSpotlight.sector}/${homeSpotlight.id}`} class="cover-story-link">
          <div class="cover-story-image" style={`background-image: url('${homeSpotlight.data.image}')`}></div>
          <div class="cover-story-overlay"></div>
          <div class="cover-story-content">
            <div class="cover-story-meta">
              {homeSpotlight.sectorLabel}
            </div>
            <h2 class="cover-story-title">
              {homeSpotlight.data.coverTitleLines ? (
                homeSpotlight.data.coverTitleLines.map((line: string, i: number) => (
                  i === 0
                    ? <span class="cover-story-title-intro">{line}</span>
                    : <span class="cover-story-title-line">{line}</span>
                ))
              ) : (
                <span class="cover-story-title-line">{coverTitle}</span>
              )}
            </h2>
            <p class="cover-story-description">{homeSpotlight.data.description}</p>
            <span class="cover-story-cta">Read the scenario →</span>
          </div>
        </a>
      </section>
    )}

    <!-- PERSONAL ROW -->
    <section class="home-personal-row" id="personal-row" style="display: none;">
      <div class="home-personal-panel" id="continue-panel">
        <div class="personal-panel-header">
          <h3>Continue Reading</h3>
          <a href="/continue" class="section-see-all">See all →</a>
        </div>
        <div class="personal-panel-list" id="continue-list"></div>
      </div>
      <div class="home-personal-panel" id="bookmarks-panel">
        <div class="personal-panel-header">
          <h3>Bookmarks</h3>
          <a href="/bookmarks" class="section-see-all">See all →</a>
        </div>
        <div class="personal-panel-list" id="bookmarks-list"></div>
      </div>
    </section>

    <!-- LATEST -->
    <section class="home-section">
      <div class="section-header-row">
        <h2 class="home-section-title">Latest Scenarios</h2>
        <a href="/latest" class="section-see-all">View all →</a>
      </div>
      <div class="home-latest">
        {latest3.map(article => (
          <a href={`/${article.sector}/${article.id}`} class="home-latest-item">
  <div class="home-latest-img-wrap">
    <img 
      src={article.data.image} 
      alt={article.data.title}
      class="home-latest-img"
      loading="lazy"
      width="600"
      height="375"
    />
  </div>
  <div class="home-latest-sector">{article.sectorLabel}</div>
  <h3 class="home-latest-title">{article.data.title}</h3>
  <p class="home-latest-desc">{article.data.description}</p>
  <div class="home-latest-rule"></div>
</a>
        ))}
      </div>
    </section>

    <!-- EXPLORE -->
    <section class="home-section">
      <h2 class="home-section-title">Explore the Worlds</h2>
      <div class="home-explore">
        {exploreSectors.map(s => (
          <a href={`/${s.key}`} class="home-explore-card">
  <img 
    src={s.img} 
    alt=""
    class="home-explore-img"
    loading="lazy"
    width="400"
    height="533"
  />
  <div class="home-explore-overlay"></div>
  <div class="home-explore-content">
  <h3 class="home-explore-title">{s.label}</h3>
  <p class="home-explore-accent">{s.accent}</p>
  <span class="home-explore-count">
    {counts[s.key]} {counts[s.key] === 1 ? 'scenario' : 'scenarios'} →
  </span>
</div>
</a>
        ))}
      </div>
    </section>

    <!-- RANDOM — editorial closing CTA -->
    <section class="home-random">
      <div class="home-random-inner">
        <div class="home-random-text">
          <span class="home-random-label">Not sure where to start?</span>
          <p class="home-random-line">
            Discover a random scenario from the archive.
          </p>
        </div>
        <button class="home-random-btn" id="random-btn">
          Surprise me →
        </button>
      </div>
    </section>

  </div>

  <script define:vars={{ allArticles }}>
    // RANDOM SCENARIO — избира от ВСИЧКИ статии в archive-а
    const randBtn = document.getElementById('random-btn');
    randBtn?.addEventListener('click', () => {
      if (!allArticles || allArticles.length === 0) return;
      const pick = allArticles[Math.floor(Math.random() * allArticles.length)];
      window.location.href = pick.url;
    });

    // PERSONAL ROW — Continue Reading + Bookmarks
    const continueList = document.getElementById('continue-list');
    const bookmarksList = document.getElementById('bookmarks-list');
    const personalRow = document.getElementById('personal-row');
    const continuePanel = document.getElementById('continue-panel');
    const bookmarksPanel = document.getElementById('bookmarks-panel');

    function renderPersonal() {
      if (
        !continueList ||
        !bookmarksList ||
        !personalRow ||
        !continuePanel ||
        !bookmarksPanel
      ) return;

      let continueData = [];
      let bookmarksData = [];

      try {
        const parsed = JSON.parse(localStorage.getItem('hig_continue') || '[]');
        continueData = Array.isArray(parsed) ? parsed : [];
      } catch {
        continueData = [];
      }

      try {
        const parsed = JSON.parse(localStorage.getItem('hig_bookmarks') || '[]');
        bookmarksData = Array.isArray(parsed) ? parsed : [];
      } catch {
        bookmarksData = [];
      }

      // Continue Reading: без дублиране, без 0% и без завършени статии.
      const uniqueContinue = new Map();

      continueData
        .filter(c =>
          Number(c.progress) > 0 &&
          Number(c.progress) < 90 &&
          c.id &&
          c.sector
        )
        .sort((a, b) => Number(b.ts || 0) - Number(a.ts || 0))
        .forEach(c => {
          const key = `${c.sector}/${c.id}`;
          if (!uniqueContinue.has(key)) uniqueContinue.set(key, c);
        });

      continueData = [...uniqueContinue.values()].slice(0, 3);

      // Bookmarks.
      bookmarksData = bookmarksData
        .filter(b => b && (typeof b === 'string' || b.id))
        .sort((a, b) => Number(b.ts || 0) - Number(a.ts || 0))
        .slice(0, 3);
        // Показваме само секциите, които имат съдържание.
const hasContinue = continueData.length > 0;
const hasBookmarks = bookmarksData.length > 0;

continuePanel.style.display = hasContinue ? '' : 'none';
bookmarksPanel.style.display = hasBookmarks ? '' : 'none';

personalRow.style.display =
  hasContinue || hasBookmarks ? 'grid' : 'none';

            // Continue Reading cards.
      continueList.innerHTML = continueData.length
        ? continueData.map(c => `
            <div class="personal-card-wrap">
              <a
                href="${c.url}?from=continue&scrollY=${Math.max(0, Number(c.scrollY) || 0)}"
                class="personal-card"
              >
                <span class="personal-card-sector">${c.sector || 'Scenario'}</span>
                <h4>${c.title || c.id}</h4>
                <div class="personal-progress">
                  <div class="personal-progress-bar" style="width:${Number(c.progress) || 0}%"></div>
                </div>
                <span class="personal-progress-text">${Math.round(Number(c.progress) || 0)}% read</span>
              </a>
              <button
                type="button"
                class="section-see-all personal-remove"
                data-remove-continue="${c.id}"
                data-remove-sector="${c.sector}"
              >✕ Remove</button>
            </div>
          `).join('')
        : `<div class="personal-empty">Nothing in progress.<span>Start reading a scenario.</span></div>`;

      // Bookmarks cards.
      bookmarksList.innerHTML = bookmarksData.length
        ? bookmarksData.map(b => {
            const item = typeof b === 'string'
              ? { id: b, url: '', sector: 'Scenario', title: b }
              : b;

            const url = item.url || `/${item.sector}/${item.id}`;

            return `
              <div class="personal-card-wrap">
                <a href="${url}" class="personal-card">
                  <span class="personal-card-sector">${item.sector || 'Scenario'}</span>
                  <h4>${item.title || item.id}</h4>
                  <p>${item.description || ''}</p>
                </a>
                <button
                  type="button"
                  class="section-see-all personal-remove"
                  data-remove-bookmark="${item.id}"
                  data-remove-sector="${item.sector || ''}"
                >✕ Remove</button>
              </div>
            `;
          }).join('')
        : `<div class="personal-empty">No bookmarks yet.<span>Tap ☆ on any scenario to save it.</span></div>`;

      // Remove from Continue Reading.
      continueList.querySelectorAll('[data-remove-continue]').forEach(btn => {
        btn.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();

          const id = btn.dataset.removeContinue;
          const sector = btn.dataset.removeSector;

          try {
            const items = JSON.parse(localStorage.getItem('hig_continue') || '[]');
            const filtered = (Array.isArray(items) ? items : []).filter(
              item => !(item.id === id && item.sector === sector)
            );

            localStorage.setItem('hig_continue', JSON.stringify(filtered));
            renderPersonal();
          } catch (error) {
            console.error('Could not remove Continue Reading item.', error);
          }
        });
      });

      // Remove from Bookmarks.
      bookmarksList.querySelectorAll('[data-remove-bookmark]').forEach(btn => {
        btn.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();

          const id = btn.dataset.removeBookmark;
          const sector = btn.dataset.removeSector;

          try {
            const items = JSON.parse(localStorage.getItem('hig_bookmarks') || '[]');
            const filtered = (Array.isArray(items) ? items : []).filter(item => {
              if (typeof item === 'string') return item !== id;
              return !(item.id === id && (item.sector || '') === sector);
            });

            localStorage.setItem('hig_bookmarks', JSON.stringify(filtered));
            renderPersonal();
          } catch (error) {
            console.error('Could not remove bookmark.', error);
          }
        });
      });
          }

    renderPersonal();

    window.addEventListener('pageshow', renderPersonal);

    window.addEventListener('storage', event => {
      if (
        event.key === 'hig_continue' ||
        event.key === 'hig_bookmarks' ||
        event.key === null
      ) {
        renderPersonal();
      }
    });
</script>
</BaseLayout>