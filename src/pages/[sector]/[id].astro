---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import {
  ArticleHero,
  ArticleIntro,
  ArticleNarrative,
  ArticleTimeline,
  ArticleExploration,
  ArticleInteractions,
} from '../../components/article';
import { buildArticlePageData } from '../../lib/article/page-data';
import { getArticleStaticPaths, getAllArticles, getArticleContentEntities } from '../../lib/article/repository';

export async function getStaticPaths() {
  return getArticleStaticPaths();
}

const { post, sector } = Astro.props;
const articleContentEntities = await getArticleContentEntities({ ...post, sector });
const narrativeSections = await Promise.all(articleContentEntities.map(async (entity) => ({
  id: entity.data.id,
  kind: entity.data.kind,
  Content: (await render(entity)).Content,
})));
const { title, description, image, world, divergence } = post.data;
const allPosts = await getAllArticles();
const narrativeBody = articleContentEntities.map((entity) => entity.body).join('\n\n');
const page = buildArticlePageData(post, sector, allPosts, narrativeBody);
---

<BaseLayout

   title={`${title} | Had It Gone`}

   description={description}

   image={image}

   url={page.pageUrl}

   type="article"

>

   <article class="article-page scenario-experience">

      <!-- 1. BREADCRUMBS -->

      <!-- 2. Shared page title, followed by the article hero card -->

      <PageHeader title={title} description={description} />

      <ArticleHero
         sector={sector}
         sectorTitle={page.sectorTitle}
         world={world}
         image={image}
         divergence={divergence}
         readingTime={page.readingTime}
         articleId={post.id}
      />

      <!-- 3. ARTICLE INTRO: CONTENTS + WORLD COMPARISON -->

      <ArticleIntro divergence={divergence} />

      <!-- 4. NARRATIVE -->

      <ArticleNarrative>
         {narrativeSections.map(({ id, kind, Content }) => (
            <section
               class={kind === 'intro' ? 'narrative-section narrative-intro-section' : 'narrative-section'}
               data-content-entity-id={id}
            >
               <Content />
            </section>
         ))}
      </ArticleNarrative>

      <!-- 5. TIMELINE -->
      <ArticleTimeline items={page.timelineItems} />

      <!-- 6. EXPLORATION -->
      <ArticleExploration
         alternativePaths={page.alternativePaths}
         relatedArticles={page.relatedArticles}
         worldName={world?.name}
         title={title}
         pageUrl={page.pageUrl}
         sector={sector}
         sectorTitle={page.sectorTitle}
      />
   </article>

   <!-- Client-side article interactions -->
   <ArticleInteractions />

</BaseLayout>
