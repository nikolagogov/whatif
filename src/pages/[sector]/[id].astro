---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const historyPosts = await getCollection('history');
  const sciencePosts = await getCollection('science');
  const spacePosts = await getCollection('space');
  const societyPosts = await getCollection('society');

  const historyPaths = historyPosts.map(post => ({
    params: { sector: 'history', id: post.id },
    props: { post, sector: 'history' },
  }));

  const sciencePaths = sciencePosts.map(post => ({
    params: { sector: 'science', id: post.id },
    props: { post, sector: 'science' },
  }));

  const spacePaths = spacePosts.map(post => ({
    params: { sector: 'space', id: post.id },
    props: { post, sector: 'space' },
  }));

  const societyPaths = societyPosts.map(post => ({
    params: { sector: 'society', id: post.id },
    props: { post, sector: 'society' },
  }));

  return [...historyPaths, ...sciencePaths, ...spacePaths, ...societyPaths];
}

const { post, sector } = Astro.props;
const { Content } = await render(post);

const sectorTitles: Record<string, string> = {
  history: '🏛️ Alternate History',
  science: '🧪 Speculative Science',
  space: '🌌 Cosmic Shifts',
  society: '🌍 Society & Geopolitics',
};

const sectorTitle = sectorTitles[sector] || 'Article';

const navLinks = [
  { href: '/history', label: '🏛️ History', key: 'history' },
  { href: '/science', label: '🧪 Science', key: 'science' },
  { href: '/space', label: '🌌 Space', key: 'space' },
  { href: '/society', label: '🌍 Society', key: 'society' },
];

// СВЪРЗАНИ СТАТИИ
const historyAll = await getCollection('history');
const scienceAll = await getCollection('science');
const spaceAll = await getCollection('space');
const societyAll = await getCollection('society');

const allPostsCombined = [
  ...historyAll.map(p => ({ ...p, sector: 'history' })),
  ...scienceAll.map(p => ({ ...p, sector: 'science' })),
  ...spaceAll.map(p => ({ ...p, sector: 'space' })),
  ...societyAll.map(p => ({ ...p, sector: 'society' })),
];

const otherPosts = allPostsCombined.filter(p => 
  !(p.sector === sector && p.id === post.id)
);

const currentTags = post.data.tags || [];

// Статии с общи тагове
const relatedByTags = otherPosts.filter(p => 
  p.data.tags && p.data.tags.length > 0 && 
  p.data.tags.some(tag => currentTags.includes(tag))
);

// Fallback 1: статии от същата секция
const sectorPosts = otherPosts.filter(p => 
  p.sector === sector && 
  !relatedByTags.some(r => r.sector === p.sector && r.id === p.id)
);

// Fallback 2: статии от всички други секции (ако в тази секция няма достатъчно)
const otherSectorPosts = otherPosts.filter(p => 
  p.sector !== sector && 
  !relatedByTags.some(r => r.sector === p.sector && r.id === p.id)
);

// Разбъркай
const shuffledRelated = [...relatedByTags].sort(() => Math.random() - 0.5);
const shuffledSector = [...sectorPosts].sort(() => Math.random() - 0.5);
const shuffledOther = [...otherSectorPosts].sort(() => Math.random() - 0.5);

// Комбинирай: тагове → същата секция → други секции
const combined = [...shuffledRelated, ...shuffledSector, ...shuffledOther];
const relatedPosts = combined.slice(0, 3);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{post.data.title} | The What-If Portal</title>
		<meta name="description" content={post.data.description} />
	</head>
	<body>
		<div class="reading-progress" id="readingProgress"></div>

		<nav>
			<a href="/" class="logo">What If <span>Hub</span></a>
			<ul class="nav-links">
				{navLinks.map(link => (
					<li>
						<a href={link.href} class={link.key === sector ? 'active' : ''}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="page-frame">
			<article class="article-page">
				<a href={`/${sector}`} class="sector-tag">{sectorTitle}</a>

				<div class="article-hero">
					<div class="hero-image" style={`background-image: url('${post.data.image}');`}></div>
					<div class="hero-text">
						<h1>{post.data.title}</h1>
						<p class="hero-description">{post.data.description}</p>
					</div>
				</div>

				<div class="article-body">
					<Content />
				</div>

				{relatedPosts.length > 0 && (
					<div class="related-articles">
						<h3 class="related-title">📖 Read next</h3>
						<div class="related-grid">
							{relatedPosts.map(related => (
								<a href={`/${related.sector}/${related.id}`} class="related-card">
									<div class="related-img" style={`background-image: url('${related.data.image}');`}></div>
									<div class="related-body">
										<span class="related-sector">{related.sector}</span>
										<h4>{related.data.title}</h4>
									</div>
								</a>
							))}
						</div>
					</div>
				)}

				<a href={`/${sector}`} class="back-link">← Back to {sectorTitle}</a>
			</article>

			<footer class="site-footer">
				<div class="footer-logo">What If <span>Hub</span></div>
				<ul class="footer-links">
					<li><a href="/">Home</a></li>
					<li><a href="/history">History</a></li>
					<li><a href="/science">Science</a></li>
					<li><a href="/space">Space</a></li>
					<li><a href="/society">Society</a></li>
				</ul>
				<p class="footer-copy">© 2026 The What-If Portal. All rights reserved.</p>
			</footer>
		</div>

		<script>
			const progressBar = document.getElementById('readingProgress') as HTMLElement | null;
			if (progressBar) {
				window.addEventListener('scroll', () => {
					const scrollTop = window.scrollY;
					const docHeight = document.documentElement.scrollHeight - window.innerHeight;
					const progress = (scrollTop / docHeight) * 100;
					progressBar.style.width = progress + '%';
				});
			}
		</script>
	</body>
</html>