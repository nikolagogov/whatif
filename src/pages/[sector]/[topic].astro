---
import { articleRoute, sectorRoute, ROUTES } from '../../lib/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getTopicPageData, getTopicStaticPaths } from '../../lib/article/repository';

export async function getStaticPaths() {
  return getTopicStaticPaths();
}

const { sector, topic } = Astro.params;

if (!sector || !topic) {
  throw new Error('Topic route requires both sector and topic parameters.');
}

const { sectorConfig: info, topicConfig: tile, posts: topicPosts } =
  await getTopicPageData(sector, topic);

---

<BaseLayout
  title={`${tile.title} | ${info.title} | Had It Gone`}
  description={tile.subtitle}
  image={info.image}
  url={articleRoute(sector, topic)}
  type="website"
>
  <div class="section-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={ROUTES.home}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={ROUTES.content}>Discover</a>
      <span aria-hidden="true">/</span>
      <a href={sectorRoute(sector)}>{info.title}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tile.title}</span>
    </nav>

    <PageHeader title={tile.title} showBack={false} />
    {tile.subtitle && <p class="detail-page-description">{tile.subtitle}</p>}

    <!-- ARTICLES -->
    {
      topicPosts.length === 0 ? (
        <div class="no-articles">
          No articles in this topic yet.
        </div>
      ) : (
        <section class="topic-stories" aria-label={`Stories in ${tile.title}`}>
          <div class="topic-story-grid">
            {topicPosts.map((post) => (
              <ArticleCard
                href={articleRoute(sector, post.id)}
                image={post.data.image}
                title={post.data.title}
                description={post.data.description}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    color: var(--muted, #9ca3af);
    font-size: .82rem;
  }

  .breadcrumbs a {
    color: var(--muted, #aeb6c4);
    text-decoration: none;
    transition: color .2s ease;
  }

  .breadcrumbs a:hover { color: var(--accent, #e8bd72); }
  .breadcrumbs [aria-current="page"] { color: var(--text, #e8e8e8); }

  .detail-page-description {
    max-width: 760px;
    margin: -12px auto clamp(42px, 5vw, 64px);
    color: var(--hig-copy, #e8edf5);
    font-size: clamp(.98rem, 1.2vw, 1.12rem);
    line-height: 1.65;
    text-align: center;
  }
  .topic-stories { margin: 0 0 80px; }
  .topic-story-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
  }
  @media (max-width: 900px) {
    .topic-story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .breadcrumbs { margin-bottom: 22px; }
    .detail-page-description { margin: -8px auto 34px; }
    .topic-story-grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>