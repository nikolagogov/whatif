
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts } from '../../lib/sorting';

export async function getStaticPaths() {
  const sectorInfo: Record<string, { exploreTiles: { slug: string }[] }> = {
    history: {
      exploreTiles: [
        { slug: 'ancient-world' },
        { slug: 'empires' },
        { slug: 'wars' },
      ],
    },
    science: {
      exploreTiles: [
        { slug: 'evolution' },
        { slug: 'biology' },
        { slug: 'discoveries' },
        { slug: 'earth' },
        { slug: 'human-body' },
      ],
    },
    space: {
      exploreTiles: [
        { slug: 'mars-worlds' },
        { slug: 'earth-moon' },
        { slug: 'planets' },
        { slug: 'cosmic-events' },
        { slug: 'universe' },
      ],
    },
    society: {
      exploreTiles: [
        { slug: 'technology' },
        { slug: 'politics' },
        { slug: 'culture' },
        { slug: 'economics' },
        { slug: 'civilization' },
      ],
    },
  };

  const paths: { params: { sector: string; topic: string } }[] = [];

  for (const sector of Object.keys(sectorInfo)) {
    for (const tile of sectorInfo[sector].exploreTiles) {
      paths.push({
        params: { sector, topic: tile.slug },
      });
    }
  }

  return paths;
}

const { sector, topic } = Astro.params;

// Конфигурация на секциите
const sectorInfo: Record<string, any> = {
  history: {
    title: 'History',
    emoji: '🏛️',
    intro: 'Empires, wars, and decisions that could have gone another way.',
    image: '/images/sectors/history.jpg',
    exploreTiles: [
      {
        slug: 'ancient-world',
        emoji: '🏛️',
        title: 'Ancient World',
        subtitle: 'Alexander, Alexandria, and the ancient Mediterranean.',
      },
      {
        slug: 'empires',
        emoji: '👑',
        title: 'Empires',
        subtitle: 'Rome, Persia, and empires that might have followed.',
      },
      {
        slug: 'wars',
        emoji: '⚔️',
        title: 'Wars & Conflicts',
        subtitle: 'Battles and crises that changed the course of history.',
      },
    ],
  },
  science: {
    title: 'Science',
    emoji: '🧪',
    intro: 'Evolution, biology, and discoveries that could have changed the natural world.',
    image: '/images/sectors/science.jpg',
    exploreTiles: [
      {
        slug: 'evolution',
        emoji: '🦕',
        title: 'Evolution & Deep Time',
        subtitle: 'Deep time and the paths life might have taken.',
      },
      {
        slug: 'biology',
        emoji: '🧬',
        title: 'Biology & Life',
        subtitle: 'Life, cells, and the rules of the natural world.',
      },
      {
        slug: 'discoveries',
        emoji: '🔬',
        title: 'Discoveries & Inventions',
        subtitle: 'Inventions and insights that arrived early — or never.',
      },
      {
        slug: 'earth',
        emoji: '🌍',
        title: 'Earth & Environment',
        subtitle: 'The planet as it was — and as it might have been.',
      },
      {
        slug: 'human-body',
        emoji: '🧠',
        title: 'Human Body & Mind',
        subtitle: 'The body and mind as they could have evolved.',
      },
    ],
  },
  space: {
    title: 'Space',
    emoji: '🌌',
    intro: 'Altered worlds and different paths through the universe.',
    image: '/images/sectors/space.jpg',
    exploreTiles: [
      {
        slug: 'mars-worlds',
        emoji: '🔴',
        title: 'Mars & Its Lost Oceans',
        subtitle: 'The Red Planet and the oceans it might have kept.',
      },
      {
        slug: 'earth-moon',
        emoji: '🌙',
        title: 'Earth & Moon',
        subtitle: 'Our own planet and the worlds closest to it.',
      },
      {
        slug: 'planets',
        emoji: '🪐',
        title: 'Planets & Moons',
        subtitle: 'Worlds that might have taken a different shape.',
      },
      {
        slug: 'cosmic-events',
