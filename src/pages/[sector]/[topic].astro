        subtitle: 'Power, governance, and different social orders.',
      },
      {
        slug: 'culture',
        emoji: '🎭',
        title: 'Culture & Ideas',
        subtitle: 'Ideas, beliefs, and the paths they might have taken.',
      },
      {
        slug: 'economics',
        emoji: '💰',
        title: 'Economics & Trade',
        subtitle: 'Trade, wealth, and alternative economic worlds.',
      },
      {
        slug: 'civilization',
        emoji: '🏙️',
        title: 'Civilization & Collapse',
        subtitle: 'Rise, fall, and the roads not taken.',
      },
    ],
  },
};

const info = sectorInfo[sector ?? ''];
const tile = info?.exploreTiles.find(
  (t: { slug: string }) => t.slug === topic
);

if (!info || !tile) {
  throw new Error(`Topic "${topic}" not found in sector "${sector}"`);
}

// Вземаме статиите от съответната секция
const posts = await getCollection(
  sector as 'history' | 'science' | 'space' | 'society'
);

// Теми, които използват различни slug-ове в навигацията и frontmatter
const topicAliases: Record<string, string[]> = {
  'mars-worlds': ['mars', 'planets'],
};

const acceptedTopics = topicAliases[topic ?? ''] ?? [topic ?? ''];

const topicPosts = sortPosts(
  posts.filter((post) => {
    const topics = post.data.topics ?? [];

    return topics.some((value) =>
      acceptedTopics.includes(value.toLowerCase())
    );
  })
);
---

<BaseLayout
  title={`${tile.title} | ${info.title} | Had It Gone`}
  description={tile.subtitle}
  image={info.image}
  url={`https://haditgone.com/${sector}/${topic}`}
  type="website"
>
  <div class="section-container">
    <!-- TOPIC HERO -->
    <section class="topic-hero">
      <a href={`/${sector}`} class="topic-back">
        ← Back to {info.title}
      </a>

      <h1 class="topic-title">
        <span class="topic-emoji">{tile.emoji}</span>
        {tile.title}
      </h1>

      <p class="topic-subtitle">{tile.subtitle}</p>
    </section>

    <!-- ARTICLES -->
    {
      topicPosts.length === 0 ? (
        <div class="no-articles">
          No articles in this topic yet.
        </div>
      ) : (
        <section class="section-block">
          <h2 class="section-heading">
            {topicPosts.length}{' '}
            {topicPosts.length === 1 ? 'scenario' : 'scenarios'}
          </h2>

          <div class="archive-grid">
            {topicPosts.map((post) => (
              <a
                href={`/${sector}/${post.id}`}
                class="archive-card"
              >
                <div
                  class="archive-img"
                  style={`background-image: url('${post.data.image}');`}
                />

                <div class="archive-body">
                  <h4>{post.data.title}</h4>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- BACK -->
    <div class="archive-back">
      <a href={`/${sector}`} class="back-link">
        ← All {info.title}
      </a>
    </div>
  </div>
</BaseLayout>