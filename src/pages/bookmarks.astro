---
import { articleRoute, ROUTES } from '../lib/routes';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const historyPosts = await getCollection('history');
const sciencePosts = await getCollection('science');
const spacePosts = await getCollection('space');
const societyPosts = await getCollection('society');

const allPosts = [
  ...historyPosts.map(p => ({ ...p, sector: 'History', sectorSlug: 'history' })),
  ...sciencePosts.map(p => ({ ...p, sector: 'Science', sectorSlug: 'science' })),
  ...spacePosts.map(p => ({ ...p, sector: 'Space', sectorSlug: 'space' })),
  ...societyPosts.map(p => ({ ...p, sector: 'Society', sectorSlug: 'society' })),
];

// Данни за JS — id, title, description, sector, url
const articlesData = allPosts.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  image: p.data.image || '',
  sector: p.sector,
  url: articleRoute(p.sectorSlug, p.id),
}));
---

<BaseLayout
  title="Bookmarks | Had It Gone"
  description="Your saved articles on Had It Gone."
  url={ROUTES.bookmarks}
  type="website"
>
  <div class="section-container archive-page">

  <PageHeader title="Bookmarks" />

  <section class="section-block" id="bookmarksBlock" style="display: none;">
    <div class="hig-card-grid" id="bookmarksGrid"></div>
  </section>

  <section class="section-block" id="emptyBlock">
    <div class="no-articles">
      You haven't saved any articles yet.<br />
      Click the ☆ Save button on any article to bookmark it.
    </div>
  </section>
</div>

<script is:inline define:vars={{ articlesData }}>
// @ts-nocheck
(function () {
  var KEY = 'hig_bookmarks';

  var grid = document.getElementById('bookmarksGrid');
  var block = document.getElementById('bookmarksBlock');
  var empty = document.getElementById('emptyBlock');
  var count = document.getElementById('bookmarksCount');

  function render() {
    var data = [];

    try {
      var parsed = JSON.parse(localStorage.getItem(KEY) || '[]');
      data = Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      data = [];
    }

    var seen = new Set();

    var articles = data.map(function (item) {
      if (typeof item === 'string') {
        return articlesData.find(function (a) {
          return a.id === item;
        }) || null;
      }

      if (!item || !item.id) return null;

      var article = articlesData.find(function (a) {
        return a.id === item.id &&
          (!item.sector ||
           a.sector.toLowerCase() === String(item.sector).toLowerCase());
      });

      if (!article) return null;

      return {
        id: article.id,
        sector: article.sector,
        title: item.title || article.title,
        description: item.description || article.description || '',
        image: article.image || '',
        url: article.url,
        ts: Number(item.ts) || 0
      };
    }).filter(Boolean)
      .filter(function (item) {
        var key = item.sector.toLowerCase() + '/' + item.id;
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .sort(function (a, b) {
        return b.ts - a.ts;
      });

    if (grid) {
      grid.innerHTML = articles.map(function (a) {
        var safe = function (value) { return String(value || '').replace(/[&<>"']/g, function (char) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]; }); };
        return '<div class="hig-card-utility">' +
          '<a href="' + safe(a.url) + '" class="hig-content-card" aria-label="' + safe(a.title) + '">' +
          (a.image ? '<img class="hig-content-card__image" src="' + safe(a.image) + '" alt="" loading="lazy" decoding="async">' : '') +
          '<span class="hig-content-card__shade" aria-hidden="true"></span>' +
          '<span class="hig-content-card__content">' +
          '<span class="hig-content-card__eyebrow">' + safe(a.sector) + '</span>' +
          '<span class="hig-content-card__title">' + safe(a.title) + '</span>' +
          '<span class="hig-content-card__description">' + safe(a.description) + '</span>' +
          '</span></a>' +
          '<button class="hig-card-remove" type="button" aria-label="Remove bookmark" data-article-id="' +
          safe(a.id) + '" data-article-sector="' + safe(a.sector.toLowerCase()) +
          '">✕ Remove</button></div>';
      }).join('');

      grid.querySelectorAll('.hig-card-remove').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-article-id');
          var sector = btn.getAttribute('data-article-sector');

          var current = [];
          try {
            current = JSON.parse(localStorage.getItem(KEY) || '[]');
            if (!Array.isArray(current)) current = [];
          } catch (e) {
            current = [];
          }

          current = current.filter(function (item) {
            if (typeof item === 'string') return item !== id;

            return !(item && item.id === id &&
              (!item.sector ||
               String(item.sector).toLowerCase() === sector));
          });

          localStorage.setItem(KEY, JSON.stringify(current));
          render();
        });
      });
    }

    if (block) block.style.display = articles.length ? 'block' : 'none';
    if (empty) empty.style.display = articles.length ? 'none' : 'block';

    if (count) {
      count.textContent = articles.length
        ? articles.length + (articles.length === 1
          ? ' saved scenario'
          : ' saved scenarios')
        : 'No saved articles yet.';
    }
  }

  render();
  window.addEventListener('pageshow', render);
  window.addEventListener('storage', function (e) {
    if (e.key === KEY || e.key === null) render();
  });
})();
</script>
</BaseLayout>