---
import { articleRoute, ROUTES } from '../lib/routes';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';


import { sortPosts } from '../lib/sorting';

const [historyPosts, sciencePosts, spacePosts, societyPosts] =
  await Promise.all([
    getCollection('history'),
    getCollection('science'),
    getCollection('space'),
    getCollection('society'),
  ]);

const allPosts = [
  ...historyPosts.map(p => ({ ...p, sector: 'History', sectorSlug: 'history' })),
  ...sciencePosts.map(p => ({ ...p, sector: 'Science', sectorSlug: 'science' })),
  ...spacePosts.map(p => ({ ...p, sector: 'Space', sectorSlug: 'space' })),
  ...societyPosts.map(p => ({ ...p, sector: 'Society', sectorSlug: 'society' })),
];

const sortedPosts = sortPosts(allPosts);
---

<BaseLayout
  title="Latest | Had It Gone"
  description="All articles on Had It Gone, sorted by date."
  url={ROUTES.latest}
  type="website"
>
  <div class="section-container archive-page">

    <PageHeader title="Latest" />

    <section class="section-block" data-role="archive">
      <div class="archive-grid">
        {sortedPosts.map(post => (
          <ArticleCard
            href={articleRoute(post.sectorSlug, post.id)}
            image={post.data.image}
            title={post.data.title}
            description={post.data.description}
            sector={post.sector}
          />
        ))}
      </div>
    </section>

  </div>
</BaseLayout>