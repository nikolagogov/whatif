---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import spotlightDataRaw from '../data/spotlight.json';

const spotlightData = spotlightDataRaw as Record<string, string>;

export async function getStaticPaths() {
  return [
    { params: { sector: 'history' } },
    { params: { sector: 'science' } },
    { params: { sector: 'space' } },
    { params: { sector: 'society' } },
  ];
}

const { sector } = Astro.params;

type ExploreTile = {
  slug: string;
  emoji: string;
  title: string;
  subtitle: string;
};

type SectorInfo = {
  title: string;
  emoji: string;
  intro: string;
  image: string;
  archiveLabel: string;
  exploreTitle?: string;
  exploreTiles?: ExploreTile[];
};

const sectorInfo: Record<string, SectorInfo> = {
  history: {
    title: 'History',
    emoji: '🏛️',
    intro: 'Empires, wars, and decisions that could have gone another way.',
    image: '/images/sectors/history.jpg',
    archiveLabel: 'The History Archive',
    exploreTitle: 'Explore History',
    exploreTiles: [
      { slug: 'ancient-world', emoji: '🏛️', title: 'Ancient World', subtitle: 'Alexander, Alexandria, and the ancient Mediterranean.' },
      { slug: 'empires', emoji: '👑', title: 'Empires', subtitle: 'Rome, Persia, and empires that might have followed.' },
      { slug: 'wars', emoji: '⚔️', title: 'Wars & Conflicts', subtitle: 'Battles and crises that changed the course of history.' },
    ],
  },
  science: {
    title: 'Science',
    emoji: '🧪',
    intro: 'Evolution, biology, and discoveries that could have changed the natural world.',
    image: '/images/sectors/science.jpg',
    archiveLabel: 'The Science Archive',
    exploreTitle: 'Explore Science',
    exploreTiles: [
      { slug: 'evolution', emoji: '🦕', title: 'Evolution & Deep Time', subtitle: 'Deep time and the paths life might have taken.' },
      { slug: 'biology', emoji: '🧬', title: 'Biology & Life', subtitle: 'Life, cells, and the rules of the natural world.' },
      { slug: 'discoveries', emoji: '🔬', title: 'Discoveries & Inventions', subtitle: 'Inventions and insights that arrived early — or never.' },
      { slug: 'earth', emoji: '🌍', title: 'Earth & Environment', subtitle: 'The planet as it was — and as it might have been.' },
      { slug: 'human-body', emoji: '🧠', title: 'Human Body & Mind', subtitle: 'The body and mind as they could have evolved.' },
    ],
  },
  space: {
    title: 'Space',
    emoji: '🌌',
    intro: 'Altered worlds and different paths through the universe.',
    image: '/images/sectors/space.jpg',
    archiveLabel: 'The Space Archive',
    exploreTitle: 'Explore Space',
    exploreTiles: [
      { slug: 'mars-worlds', emoji: '🔴', title: 'Mars & Its Lost Oceans', subtitle: 'A world that might have remained blue, warm, and habitable.' },
      { slug: 'earth-moon', emoji: '🌙', title: 'Earth & Moon', subtitle: 'Our own planet and the worlds closest to it.' },
      { slug: 'planets', emoji: '🪐', title: 'Planets & Moons', subtitle: 'Worlds that might have taken a different shape.' },
      { slug: 'cosmic-events', emoji: '☄️', title: 'Cosmic Events', subtitle: 'Impacts, collisions, and other turning points.' },
      { slug: 'universe', emoji: '✨', title: 'Stars & Universe', subtitle: 'The cosmos at scales we can barely imagine.' },
    ],
  },
  society: {
    title: 'Society',
    emoji: '🌍',
    intro: 'Systems, technologies, and cultures that might have shaped a different world.',
    image: '/images/sectors/society.jpg',
    archiveLabel: 'The Society Archive',
    exploreTitle: 'Explore Society',
    exploreTiles: [
      { slug: 'technology', emoji: '💡', title: 'Technology & Innovation', subtitle: 'Inventions and systems that might have changed us.' },
      { slug: 'politics', emoji: '🏛️', title: 'Politics & Power', subtitle: 'Power, governance, and different social orders.' },
      { slug: 'culture', emoji: '🎭', title: 'Culture & Ideas', subtitle: 'Ideas, beliefs, and the paths they might have taken.' },
      { slug: 'economics', emoji: '💰', title: 'Economics & Trade', subtitle: 'Trade, wealth, and alternative economic worlds.' },
      { slug: 'civilization', emoji: '🏙️', title: 'Civilization & Collapse', subtitle: 'Rise, fall, and the roads not taken.' },
    ],
  },
};

const info = sectorInfo[sector] || {
  title: 'Articles',
  emoji: '📄',
  intro: '',
  image: '',
  archiveLabel: 'The Archive',
};

const posts = await getCollection(sector as 'history' | 'science' | 'space' | 'society');

// Сортиране по дата (най-новите първи)
import { sortPosts } from '../lib/sorting';

// ...

const sortedByDate = sortPosts(posts);

// Spotlight — от JSON файла
const spotlightId = spotlightData[sector];
const spotlightPost =
  sortedByDate.find(p => p.id === spotlightId) || sortedByDate[0];

// Latest — 3 най-нови статии, различни от Spotlight
const latestPosts = sortedByDate
  .filter(p => p.id !== spotlightPost?.id)
  .slice(0, 3);

// Archive — останалите (без Spotlight и Latest)
const latestIds = latestPosts.map(p => p.id);
const archivePosts = sortedByDate.filter(
  p => p.id !== spotlightPost?.id && !latestIds.includes(p.id)
);

// Explore — само ако има ≥ 6 статии и секцията има дефинирани плочки
const showExplore = !!info.exploreTiles?.length;
---

<BaseLayout
  title={`${info.title} | Had It Gone`}
  description={info.intro}
  image={info.image}
  url={`https://haditgone.com/${sector}`}
  type="website"
>
  <div class="section-container" data-sector={sector}>

    {/* SECTOR HERO */}
    <section class="section-hero">
      <div class="sector-header-img" style={`background-image: url('${info.image}');`}></div>
      <div class="sector-header-body">
        <h1>
          <span class="sector-emoji">{info.emoji}</span>
          <span class="sector-title">{info.title}</span>
        </h1>
        <p>{info.intro}</p>
        <a href="/" class="back-link">← Back to Homepage</a>
      </div>
    </section>

    {posts.length === 0 ? (
      <div class="no-articles">No articles in this sector yet.</div>
    ) : (
      <>
        {/* SPOTLIGHT */}
        {spotlightPost && (
          <section class="section-block" data-role="spotlight">
            <h2 class="section-heading">🔦 Spotlight</h2>
            <a href={`/${sector}/${spotlightPost.id}`} class="spotlight-card">
              <div
                class="spotlight-img"
                style={`background-image: url('${spotlightPost.data.image}');`}
              ></div>
              <div class="spotlight-body">
                <h3>{spotlightPost.data.title}</h3>
                <p>{spotlightPost.data.description}</p>
                <span class="spotlight-cta">Read the scenario →</span>
              </div>
            </a>
          </section>
        )}

        {/* LATEST — 3 компактни карти */}
        {latestPosts.length > 0 && (
          <section class="section-block" data-role="latest">
            <h2 class="section-heading">🕐 Latest</h2>
            <div class="latest-grid">
              {latestPosts.map(post => (
                <a href={`/${sector}/${post.id}`} class="latest-card">
                  <div class="latest-img" style={`background-image: url('${post.data.image}');`}></div>
                  <div class="latest-body">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* EXPLORE — topic navigation */}
        {showExplore && (
          <section class="section-block" data-role="explore">
            <h2 class="section-heading">{info.exploreTitle}</h2>
            <div class="explore-grid">
              {info.exploreTiles!.map(tile => (
                <a
                  href={`/${sector}/${tile.slug}`}
                  class="explore-tile"
                >
                  <div class="explore-emoji">{tile.emoji}</div>
                  <h4 class="explore-title">{tile.title}</h4>
                  <p class="explore-subtitle">{tile.subtitle}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* ARCHIVE */}
        <section class="section-block" data-role="archive">
          <h2 class="section-heading">
            📚 {info.archiveLabel}
          </h2>

          <div class="archive-grid">
            {archivePosts.map(post => (
              <a
                href={`/${sector}/${post.id}`}
                class="archive-card"
              >
                <div
                  class="archive-img"
                  style={`background-image: url('${post.data.image}');`}
                ></div>
                <div class="archive-body">
                  <h4>{post.data.title}</h4>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>