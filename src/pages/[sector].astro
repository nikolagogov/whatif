---
import { getCollection } from 'astro:content';
import '../styles/global.css';

export async function getStaticPaths() {
  return [
    { params: { sector: 'history' } },
    { params: { sector: 'science' } },
    { params: { sector: 'space' } },
    { params: { sector: 'society' } },
  ];
}

const { sector } = Astro.params;

const sectorInfo: Record<string, { title: string; emoji: string; description: string; image: string }> = {
  history: {
    title: 'Alternate History',
    emoji: '🏛️',
    description: 'Analyzing key turning points in human history. What if critical battles, empires, or discoveries took a completely different path?',
    image: '/images/sector-history.jpg',
  },
  science: {
    title: 'Speculative Science',
    emoji: '🧪',
    description: 'Altering the fundamental biology, physics, and evolution of our planet to see how nature would adapt.',
    image: '/images/sector-science.jpg',
  },
  space: {
    title: 'Cosmic Shifts',
    emoji: '🌌',
    description: 'Exploring celestial alterations in our solar system. What if planets changed positions or nearby worlds developed active life?',
    image: '/images/sector-space.jpg',
  },
  society: {
    title: 'Society & Geopolitics',
    emoji: '🌍',
    description: 'Exploring how different social structures, political decisions, and cultural shifts could have changed the modern world.',
    image: '/images/sector-society.jpg',
  },
};

const info = sectorInfo[sector] || { title: 'Articles', emoji: '📄', description: '', image: '' };

const posts = await getCollection(sector as 'history' | 'science' | 'space' | 'society');
const sortedPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const navLinks = [
  { href: '/history', label: '🏛️ History', key: 'history' },
  { href: '/science', label: '🧪 Science', key: 'science' },
  { href: '/space', label: '🌌 Space', key: 'space' },
  { href: '/society', label: '🌍 Society', key: 'society' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{info.title} | The What-If Portal</title>
		<meta name="description" content={info.description} />
	</head>
	<body>
		<div class="page-frame">
			<nav>
				<a href="/" class="logo">What If <span>Hub</span></a>
				<ul class="nav-links">
					{navLinks.map(link => (
						<li>
							<a href={link.href} class={link.key === sector ? 'active' : ''}>{link.label}</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="sector-header">
				<div class="sector-header-img" style={`background-image: url('${info.image}');`}></div>
				<div class="sector-header-body">
					<h1>{info.emoji} {info.title}</h1>
					<p>{info.description}</p>
					<a href="/" class="back-link">← Back to Portal</a>
				</div>
			</div>

			<div class="articles-container">
				{sortedPosts.length === 0 ? (
					<div class="no-articles">No articles in this sector yet.</div>
				) : (
					sortedPosts.map(post => (
						<a href={`/${sector}/${post.id}`} class="article-card">
							<div class="article-card-img" style={`background-image: url('${post.data.image}');`}></div>
							<div class="article-card-body">
								{post.data.featured && <span class="featured-tag">★ Featured</span>}
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</div>
						</a>
					))
				)}
			</div>
		</div>
	</body>
</html>