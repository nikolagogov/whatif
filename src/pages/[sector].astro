---
import { articleRoute, sectorRoute } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Card from '../components/Card.astro';
import {
  ARTICLE_SECTORS,
  isConfiguredArticleSector,
} from '../lib/article/config';
import { getSectorPageData } from '../lib/article/repository';

export async function getStaticPaths() {
  return ARTICLE_SECTORS.map((sector) => ({ params: { sector } }));
}

const { sector } = Astro.params;

if (!sector || !isConfiguredArticleSector(sector)) {
  throw new Error(`Unknown article sector: ${sector ?? '(missing)'}`);
}

const { config: info, posts, latestPosts, archivePosts, visibleExploreTopics } =
  await getSectorPageData(sector);

// Show Explore when the sector has configured topics with published articles.
const showExplore = visibleExploreTopics.length > 0;

---

<BaseLayout
  title={`${info.title} | Had It Gone`}
  description={info.intro}
  image={info.image}
  url={sectorRoute(sector)}
  type="website"
>
  <div class="section-container" data-sector={sector}>

    <PageHeader title="Discover" highlight={info.title} />

    {
      posts.length === 0 ? (
        <div class="no-articles">
          No articles in this sector yet.
        </div>
      ) : (
        <>
          <!-- Latest -->
          {
            latestPosts.length > 0 && (
              <section class="section-block" data-role="latest">
                <h2 class="section-heading">
                  Latest
                </h2>

                <div class="latest-grid">
                  {
                    latestPosts.map((post) => (
                      <ArticleCard
                        href={articleRoute(sector, post.id)}
                        image={post.data.image}
                        title={post.data.title}
                        description={post.data.description}
                      />
                    ))
                  }
                </div>
              </section>
            )
          }

          <!-- Explore -->
          {
            showExplore && (
              <section class="section-block" data-role="explore">
                <h2 class="section-heading">
                  {info.exploreTitle}
                </h2>

                <div class="explore-grid">
                  {
                    visibleExploreTopics.map((tile) => (
                      <Card
                        href={articleRoute(sector, tile.slug)}
                        image={tile.image}
                        title={tile.title}
                        description={'cardDescription' in tile ? tile.cardDescription : tile.subtitle}
                      />
                    ))
                  }
                </div>
              </section>
            )
          }

          <!-- Archive -->
          <section class="section-block" data-role="archive">
            <h2 class="section-heading">
              {info.archiveLabel}
            </h2>

            <div class="archive-grid">
              {
                archivePosts.map((post) => (
                  <ArticleCard
                    href={articleRoute(sector, post.id)}
                    image={post.data.image}
                    title={post.data.title}
                    description={post.data.description}
                  />
                ))
              }
            </div>
          </section>
        </>
      )
    }
  </div>
</BaseLayout>