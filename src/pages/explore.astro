      display: flex;

      align-items: end;

      justify-content: space-between;

      gap: 24px;

      margin-bottom: 24px;

    }



    .section-heading .eyebrow,

    .timeline-heading .eyebrow { margin-bottom: 8px; }



    .section-heading h2,

    .timeline-heading h2 {

      margin: 0;

      font-size: clamp(24px, 3vw, 34px);

      letter-spacing: -.035em;

