      font-size: 15px;

      line-height: 1.8;

    }



    .hero-stats {

      display: flex;

      flex-shrink: 0;

      gap: 28px;

      padding-bottom: 4px;

    }



    .hero-stats div { display: grid; gap: 7px; }



    .hero-stats strong {

      font-size: 27px;

      line-height: 1;

      font-weight: 750;

    }



