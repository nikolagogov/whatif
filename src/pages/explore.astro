---

import BaseLayout from '../layouts/BaseLayout.astro';

import contentGraph from '../data/content-graph.json';



const nodes = contentGraph.nodes;

const edges = contentGraph.edges;



const nodeMap = new Map(nodes.map((node) => [node.id, node]));



const articleNodes = nodes.filter((node) => node.kind === 'article');



const worlds = nodes

  .filter((node) => node.kind === 'world')

  .map((world) => {

    const worldEdges = edges.filter(

      (edge) => edge.type === 'HAS_WORLD' && edge.to === world.id

    );



    const articles = worldEdges

      .map((edge) => nodeMap.get(edge.from))

      .filter((article) => article !== undefined);



    const articleIds = new Set(articles.map((article) => article.id));



    const divergences = edges

      .filter((edge) => edge.type === 'HAS_DIVERGENCE' && articleIds.has(edge.from))

      .map((edge) => nodeMap.get(edge.to))

      .filter((item): item is NonNullable<typeof item> => item !== undefined);



    const timeline = edges

      .filter((edge) => edge.type === 'HAS_TIMELINE_EVENT' && articleIds.has(edge.from))

      .map((edge) => nodeMap.get(edge.to))

      .filter((item) => item !== undefined);



    return {

      ...world,

      articles,

      divergences,

      timeline,

      articleUrl: articles[0]?.sector && articles[0]?.articleId

        ? `/${articles[0].sector}/${articles[0].articleId}/`

        : null,

    };

  })

  .sort((a, b) => a.label.localeCompare(b.label));



const totalEvents = worlds.reduce(

  (total, world) => total + world.timeline.length,

  0

);

---



<BaseLayout

  title="Explore Alternate Worlds | HAD IT GONE"

  description="Explore alternative worlds, follow their timelines and discover how history could have unfolded differently."

>

  <main class="explore-page">

    <section class="explore-hero">

      <div class="hero-copy">

        <p class="eyebrow">HAD IT GONE · ALTERNATE HISTORY</p>

        <h1>History could have been <span>different.</span></h1>

        <p class="hero-intro">

          Every turning point opens another path. Explore alternative worlds,

          follow the events that shape them, and discover a different version

          of our past and future.

        </p>

      </div>



      <div class="hero-stats" aria-label="Explore statistics">

        <div>

          <strong>{worlds.length}</strong>

          <span>ALTERNATE WORLDS</span>

        </div>

        <div>

          <strong>{totalEvents}</strong>

          <span>TIMELINE EVENTS</span>

        </div>

        <div>

          <strong>{articleNodes.length}</strong>

          <span>WHAT IF STORIES</span>

        </div>

      </div>

    </section>



    <section class="worlds-section" aria-labelledby="worlds-heading">

      <div class="section-heading">

        <div>

          <p class="eyebrow">CHOOSE YOUR PATH</p>

          <h2 id="worlds-heading">Explore alternative worlds</h2>

          <p>Start with a different outcome. Follow its consequences.</p>

        </div>



        <label class="world-search">

          <span aria-hidden="true">⌕</span>

          <input

            id="world-search"

            type="search"

            placeholder="Search worlds..."

            autocomplete="off"

          />

        </label>

      </div>



      <div class="world-grid" id="world-grid">

        {worlds.map((world, index) => (

          <article

            class="world-card"

            data-world-card

            data-search={`${world.label} ${world.divergences.map((item) => item.label).join(' ')} ${world.articles.map((item) => item.label).join(' ')}`.toLowerCase()}

          >

            <div class="world-art" aria-hidden="true">

              <span class="art-index">{String(index + 1).padStart(2, '0')}</span>

              <span class="art-symbol">

                {world.label.toLowerCase().includes('rome') ? 'ROMA' :

                 world.label.toLowerCase().includes('egypt') ? 'AEGYPTUS' :

                 world.label.toLowerCase().includes('mars') ? 'MARS' :

                 'WHAT IF'}

              </span>

              <span class="art-orbit orbit-one"></span>

              <span class="art-orbit orbit-two"></span>

            </div>



            <div class="world-card-body">

              <p class="card-kicker">ALTERNATE WORLD</p>

              <h3>{world.label}</h3>



              {world.divergences[0] && (

                <p class="world-divergence">

                  <span class="divergence-mark">↳</span>

                  {world.divergences[0].label}

                </p>

              )}



              <div class="world-meta">

                <span>{world.timeline.length} timeline events</span>

                <span>{world.articles.length} {world.articles.length === 1 ? 'story' : 'stories'}</span>

              </div>



              <button

                class="explore-world"

                type="button"

                data-open-world={world.id}

              >

                Explore this world <span aria-hidden="true">→</span>

              </button>

            </div>

          </article>

        ))}

      </div>



      <p class="no-worlds" id="no-worlds" hidden>

        No worlds match your search. Try another term.

      </p>

    </section>



    <section class="timeline-section" id="world-timeline" hidden>

      <div class="timeline-heading">

        <div>

          <p class="eyebrow">A DIFFERENT COURSE OF HISTORY</p>

          <h2 id="timeline-title">World timeline</h2>

          <p id="timeline-description"></p>

        </div>

        <button id="close-timeline" class="back-button" type="button">

          ← All worlds

        </button>

      </div>



      <div class="timeline-content">

        <div class="timeline-list" id="timeline-list"></div>

        <aside class="timeline-aside" id="timeline-aside"></aside>

      </div>

    </section>



    <section class="graph-note">

      <span class="graph-note-icon" aria-hidden="true">◎</span>

      <div>

        <h2>Follow the connections</h2>

        <p>

          Alternate worlds are connected to their points of divergence,

          timeline events and related stories. The knowledge graph will

          provide another way to explore those relationships.

        </p>

      </div>

      <span class="graph-note-count">{contentGraph.stats.edges} connections</span>

    </section>

  </main>



  <script is:inline define:vars={{ worlds, graphEdges: edges, graphNodes: nodes }}>

    (() => {

      const search = document.getElementById('world-search');

      const cards = [...document.querySelectorAll('[data-world-card]')];

      const noWorlds = document.getElementById('no-worlds');

      const timelineSection = document.getElementById('world-timeline');

      const timelineTitle = document.getElementById('timeline-title');

      const timelineDescription = document.getElementById('timeline-description');

      const timelineList = document.getElementById('timeline-list');

      const timelineAside = document.getElementById('timeline-aside');

      const closeTimeline = document.getElementById('close-timeline');



      if (

        !search || !noWorlds || !timelineSection || !timelineTitle ||

        !timelineDescription || !timelineList || !timelineAside ||

        !closeTimeline

      ) return;



      const escapeHtml = (value) =>

        String(value ?? '').replace(/[&<>"']/g, (char) => ({

          '&': '&amp;',

          '<': '&lt;',

          '>': '&gt;',

          '"': '&quot;',

          "'": '&#39;'

        })[char]);



      search.addEventListener('input', () => {

        const query = search.value.trim().toLowerCase();

        let visible = 0;



        cards.forEach((card) => {

          const match = (card.dataset.search || '').includes(query);

          card.hidden = !match;

          if (match) visible++;

        });



        noWorlds.hidden = visible !== 0;

      });



      function openWorld(worldId) {

        const world = worlds.find((item) => item.id === worldId);

        if (!world) return;



        timelineTitle.textContent = world.label;

        timelineDescription.textContent =

          world.divergences?.[0]?.label ||

          'Explore the events recorded in this alternative world.';



        const events = [...(world.timeline || [])];



        const yearOf = (event) => {

          const date = String(event.date || '');

          const match = date.match(/\d{3,4}/);

          return match ? Number(match[0]) : Number.MAX_SAFE_INTEGER;

        };



        events.sort((a, b) => yearOf(a) - yearOf(b));



        timelineList.innerHTML = events.length
          ? events.map((event, index) => `
              <article class="timeline-event" data-event-id="${escapeHtml(event.id)}" tabindex="0" role="button" aria-pressed="false">
                <div class="timeline-marker">${String(index + 1).padStart(2, '0')}</div>
                <div class="timeline-event-copy">
                  <p class="timeline-date">${escapeHtml(event.date || 'Date unspecified')}</p>
                  <h3>${escapeHtml(event.label)}</h3>
                  <p class="event-type">SELECT TO INSPECT <span aria-hidden="true">↗</span></p>
                </div>
              </article>
            `).join('')
          : '<p class="timeline-empty">No timeline events have been linked to this world yet.</p>';

        const divergence = world.divergences?.[0];
        const renderWorldOverview = () => `
          <p class="eyebrow">THE POINT OF DIVERGENCE</p>
          <h3>${escapeHtml(divergence?.label || 'Not specified')}</h3>
          ${divergence?.date ? `<p class="aside-date">${escapeHtml(divergence.date)}</p>` : ''}
          <p class="aside-hint">Select any event on the timeline to inspect its connections and place in this world.</p>
          <div class="aside-divider"></div>
          <p class="eyebrow">EXPLORE THE STORY</p>
          ${(world.articles || []).map((article) => {
            const url = article.sector && article.articleId
              ? `/${encodeURIComponent(article.sector)}/${encodeURIComponent(article.articleId)}/`
              : null;
            return url
              ? `<a class="story-link" href="${url}">${escapeHtml(article.label)} <span>↗</span></a>`
              : `<p>${escapeHtml(article.label)}</p>`;
          }).join('') || '<p>No linked stories are available yet.</p>'}
        `;
        timelineAside.innerHTML = renderWorldOverview();

        const inspectEvent = (eventId) => {
          const event = events.find((item) => String(item.id) === String(eventId));
          if (!event) return;
          timelineList.querySelectorAll('[data-event-id]').forEach((item) => {
            const selected = item.dataset.eventId === String(eventId);
            item.classList.toggle('is-selected', selected);
            item.setAttribute('aria-pressed', String(selected));
          });
          const causalEdges = graphEdges.filter((edge) =>
            (String(edge.from) === String(eventId) || String(edge.to) === String(eventId)) &&
            /(CAUSE|LEAD|RESULT|FOLLOW|PRECEDE|TRIGGER|CONSEQUENCE|DERIVE|TRANSITION)/i.test(String(edge.type || ''))
          );
          const connections = causalEdges.map((edge) => {
            const outgoing = String(edge.from) === String(eventId);
            const otherId = outgoing ? edge.to : edge.from;
            const other = graphNodes.find((node) => String(node.id) === String(otherId));
            if (!other) return '';
            return `<li><span class="connection-direction">${outgoing ? 'LEADS TO' : 'CAUSED BY'}</span><strong>${escapeHtml(other.label || other.title || other.id)}</strong></li>`;
          }).filter(Boolean);
          const description = event.description || event.summary || event.content || '';
          timelineAside.innerHTML = `
            <button class="aside-back" type="button" id="event-back">← World overview</button>
            <p class="eyebrow">EVENT INSPECTOR</p>
            <p class="aside-date">${escapeHtml(event.date || 'Date unspecified')}</p>
            <h3>${escapeHtml(event.label)}</h3>
            ${description ? `<p class="event-description">${escapeHtml(description)}</p>` : '<p class="aside-hint">This event is part of the recorded timeline. Explore its connected events below.</p>'}
            <div class="aside-divider"></div>
            <p class="eyebrow">CAUSAL CONNECTIONS</p>
            ${connections.length ? `<ul class="causal-connections">${connections.join('')}</ul>` : '<p class="aside-hint">No explicit causal links are recorded for this event yet.</p>'}
            <div class="aside-divider"></div>
            <p class="eyebrow">RELATED STORIES</p>
            ${(world.articles || []).map((article) => {
              const url = article.sector && article.articleId
                ? `/${encodeURIComponent(article.sector)}/${encodeURIComponent(article.articleId)}/`
                : null;
              return url ? `<a class="story-link" href="${url}">${escapeHtml(article.label)} <span>↗</span></a>` : '';
            }).join('') || '<p>No linked stories are available yet.</p>'}
          `;
          document.getElementById('event-back')?.addEventListener('click', () => {
            timelineList.querySelectorAll('[data-event-id]').forEach((item) => {
              item.classList.remove('is-selected');
              item.setAttribute('aria-pressed', 'false');
            });
            timelineAside.innerHTML = renderWorldOverview();
          });
        };

        timelineList.querySelectorAll('[data-event-id]').forEach((item) => {
          item.addEventListener('click', () => inspectEvent(item.dataset.eventId));
          item.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              inspectEvent(item.dataset.eventId);
            }
          });
        });

        timelineSection.hidden = false;

        timelineSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

      }



      document.querySelectorAll('[data-open-world]').forEach((button) => {

        button.addEventListener('click', () => {

          openWorld(button.dataset.openWorld);

        });

      });



      closeTimeline.addEventListener('click', () => {

        timelineSection.hidden = true;

        document.getElementById('worlds-heading')?.scrollIntoView({

          behavior: 'smooth',

          block: 'start'

        });

      });

    })();

  </script>



  <style is:global>

