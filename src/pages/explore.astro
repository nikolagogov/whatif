---
import { worldRoute, ROUTES } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import contentGraph from '../data/content-graph.json';

const nodes = contentGraph.nodes;
const edges = contentGraph.edges;
const nodeMap = new Map(nodes.map((node) => [node.id, node]));

const [historyArticles, scienceArticles, spaceArticles, societyArticles] = await Promise.all([
  getCollection('history'),
  getCollection('science'),
  getCollection('space'),
  getCollection('society'),
]);
const articleByPath = new Map([
  ...historyArticles.map((article) => [`src/content/history/${article.id}.md`, article]),
  ...scienceArticles.map((article) => [`src/content/science/${article.id}.md`, article]),
  ...spaceArticles.map((article) => [`src/content/space/${article.id}.md`, article]),
  ...societyArticles.map((article) => [`src/content/society/${article.id}.md`, article]),
]);

const worldImageById: Record<string, string> = {
  'world-alexander-west': '/images/world-cards/world-alexander-west.webp',
  'world-alexandria-survives': '/images/world-cards/world-alexandria.webp',
  'world-aztec-atlantic': '/images/world-cards/world-aztec-atlantic.webp',
  'world-nuclear-war-1962': '/images/world-cards/world-nuclear-aftermath.webp',
  'world-islamic-europe': '/images/world-cards/world-islamic-europe.webp',
  'world-napoleonic-europe': '/images/world-cards/world-napoleonic-europe.webp',
  'world-western-rome-survives': '/images/world-cards/world-roman-empire.webp',
  'world-spanish-armada-victory': '/images/world-cards/world-catholic-england.webp',
  'world-ottoman-vienna': '/images/world-cards/world-divided-europe.webp',
  'world-dinosaurs-survive': '/images/world-cards/world-dinosaurs.webp',
  'world-living-mars': '/images/world-cards/world-living-mars.webp',
  'world-disconnected-world': '/images/world-cards/world-disconnected-world.webp',
};

const worlds = nodes
  .filter((node) => node.kind === 'world')
  .map((world) => {
    const worldEdges = edges.filter((edge) => edge.type === 'HAS_WORLD' && edge.to === world.id);
    const articles = worldEdges
      .map((edge) => nodeMap.get(edge.from))
      .filter((article) => article !== undefined);
    const articleIds = new Set(articles.map((article) => article.id));
    const divergences = edges
      .filter((edge) => edge.type === 'HAS_DIVERGENCE' && articleIds.has(edge.from))
      .map((edge) => nodeMap.get(edge.to))
      .filter((item) => item !== undefined);
    const timeline = edges
      .filter((edge) => edge.type === 'HAS_TIMELINE_EVENT' && articleIds.has(edge.from))
      .map((edge) => nodeMap.get(edge.to))
      .filter((item) => item !== undefined);

    return {
      ...world,
      articles,
      divergences,
      timeline,
      description: articles
        .map((article) => article.path ? articleByPath.get(article.path) : undefined)
        .find((article) => article !== undefined)?.data.description ?? '',
      image: worldImageById[world.id] ?? '/images/platform-hero-background.jpg',
    };
  })
  .sort((a, b) => a.label.localeCompare(b.label));
---

<BaseLayout
  title="Explore Alternative Worlds | HAD IT GONE"
  description="Explore alternate worlds, follow the events that shape them, and discover different versions of our past and future."
>
  <main class="explore-page">
    <PageHeader title="Explore alternative" highlight="worlds." showBack={false} />

    <section class="explore-hero" aria-label="About Explore">
      <p class="hero-intro">
        Every turning point opens another path. Explore alternative worlds, follow the events that shape them, and discover a different version of our past and future.
      </p>
    </section>

    <section class="worlds-section" aria-label="Browse alternative worlds">
      <div class="world-search-wrap">
        <label class="world-search">
          <span aria-hidden="true">⌕</span>
          <input id="world-search" type="search" placeholder="Search worlds..." autocomplete="off" />
        </label>
        <p class="world-search-hint">Find a world by name</p>
      </div>

      <div class="world-grid" id="world-grid">
        {worlds.map((world) => (
          <div
            class="world-card-item"
            data-world-card
            data-search={`${world.label} ${world.description} ${world.divergences.map((item) => item.label).join(' ')} ${world.articles.map((item) => item.label).join(' ')}`.toLowerCase()}
          >
            <ArticleCard
              href={worldRoute(world.id)}
              image={world.image}
              title={world.label}
              description={world.description}
              ariaLabel={`Explore ${world.label}`}
            />
          </div>
        ))}
      </div>

      <p class="no-worlds" id="no-worlds" hidden>No worlds match your search. Try another term.</p>
    </section>

    <a class="timeline-card explore-timeline-entry" href={ROUTES.timeline} aria-label="Explore the Timeline" hidden>
      <img class="timeline-card-image" src="/images/timeline-concept.webp" alt="" loading="lazy" decoding="async" />
      <span class="timeline-card-shade" aria-hidden="true"></span>
      <span class="timeline-card-content">
        <span class="timeline-card-title" id="timeline-entry-title">Explore the Timeline</span>
        <span class="timeline-card-description">Follow the turning points that shaped our world. Discover the events, decisions and moments that changed the course of history.</span>
      </span>
    </a>
  </main>

  <script is:inline>
    (() => {
      const search = document.getElementById('world-search');
      const cards = [...document.querySelectorAll('[data-world-card]')];
      const noWorlds = document.getElementById('no-worlds');
      if (!search || !noWorlds) return;
      search.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const match = (card.dataset.search || '').includes(query);
          card.hidden = !match;
          if (match) visible += 1;
        });
        noWorlds.hidden = visible !== 0;
      });
    })();
  </script>

  <style>
    [hidden] { display: none !important; }
    .explore-page {
      width: min(100% - 64px, 1500px);
      max-width: 1500px;
      margin: 0 auto;
      padding: 48px 0 24px;
      color: #e8edf5;
    }
    .explore-hero {
      display: flex;
      justify-content: center;
      padding: 4px 0 34px;
      border-bottom: 1px solid rgba(157, 173, 198, .16);
    }
    .hero-intro {
      max-width: 850px;
      margin: 0 auto;
      color: #aeb9c9;
      font-size: 15px;
      line-height: 1.8;
      text-align: center;
    }
    .worlds-section { padding-top: 26px; }
    .world-search-wrap {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin: 0 auto 24px;
    }
    .world-search {
      display: flex;
      align-items: center;
      gap: 11px;
      width: min(430px, 100%);
      padding: 0 17px;
      border: 1px solid rgba(145, 163, 185, .34);
      border-radius: 999px;
      background: rgba(12, 24, 38, .82);
      color: #d5ad6c;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .14), inset 0 1px 0 rgba(255, 255, 255, .035);
      backdrop-filter: blur(8px);
      transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }
    .world-search > span {
      font-size: 18px;
      line-height: 1;
      opacity: .9;
    }
    .world-search:focus-within {
      border-color: rgba(219, 166, 92, .72);
      background: rgba(16, 31, 48, .94);
      box-shadow: 0 0 0 3px rgba(219, 166, 92, .08), 0 10px 28px rgba(0, 0, 0, .18);
    }
    .world-search input {
      width: 100%;
      min-width: 0;
      padding: 13px 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #edf2fa;
      font: inherit;
      font-size: 13px;
    }
    .world-search input::placeholder { color: #9aa8ba; opacity: .9; }
    .world-search input:focus-visible { outline: none; }
    .world-search-hint {
      margin: 0;
      color: rgba(174, 185, 201, .72);
      font-size: 11px;
      line-height: 1.4;
      letter-spacing: .015em;
      text-align: left;
      white-space: nowrap;
    }
    .world-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      align-items: stretch;
    }
    .world-card-item { min-width: 0; height: 100%; }
    .no-worlds { margin: 28px 0; color: #aeb9c9; text-align: center; }
    .timeline-card {
      position: relative;
      display: block;
      min-height: 132px;
      margin-top: 34px;
      overflow: hidden;
      isolation: isolate;
      color: inherit;
      text-decoration: none;
      background: #071522;
      border: 1px solid rgba(219,166,92,.42);
      border-radius: 14px;
      box-shadow: 0 12px 34px rgba(0,0,0,.18);
      transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }
    .timeline-card:hover,
    .timeline-card:focus-visible {
      transform: translateY(-3px);
      border-color: rgba(232,183,95,.95);
      box-shadow: 0 20px 48px rgba(0,0,0,.32), 0 0 0 1px rgba(232,183,95,.2);
    }
    .timeline-card:focus-visible { outline: 2px solid #dba65c; outline-offset: 4px; }
    .timeline-card-image,
    .timeline-card-shade {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    .timeline-card-image {
      z-index: 0;
      object-fit: cover;
      object-position: center 48%;
      transition: transform .7s cubic-bezier(.2,.65,.3,1);
    }
    .timeline-card-shade {
      z-index: 1;
      background: linear-gradient(90deg, rgba(4,11,20,.48), rgba(4,11,20,.48)), linear-gradient(180deg, rgba(4,11,20,.18), rgba(4,11,20,.58));
    }
    .timeline-card:hover .timeline-card-image,
    .timeline-card:focus-visible .timeline-card-image { transform: scale(1.035); }
    .timeline-card-content {
      position: relative;
      z-index: 2;
      display: flex;
      width: min(100%, 920px);
      min-height: 132px;
      box-sizing: border-box;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-inline: auto;
      padding: 16px 30px;
      text-align: center;
    }
    .timeline-card-title {
      display: block;
      color: #e9b85f;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(30px, 3vw, 40px);
      font-style: italic;
      line-height: 1.15;
      text-shadow: 0 2px 16px rgba(0,0,0,.65);
    }
    .timeline-card-description {
      display: block;
      max-width: 760px;
      color: #f0f3f7;
      text-align: center;
      font-size: 16px;
      line-height: 1.45;
      text-shadow: 0 2px 12px rgba(0,0,0,.8);
    }
    @media (max-width: 1050px) {
      .explore-page { width: min(100% - 48px, 900px); }
      .world-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 650px) {
      .explore-page { width: calc(100% - 32px); padding: 28px 0 18px; }
      .explore-hero { padding-bottom: 26px; }
      .hero-intro { font-size: 14px; }
      .worlds-section { padding-top: 26px; }
      .world-search-wrap { width: 100%; margin-bottom: 20px; }
      .world-search { width: min(430px, 100%); }
      .world-search-hint { display: none; }
      .world-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }

      .timeline-card { min-height: 150px; margin-top: 26px; }
      .timeline-card-content { min-height: 150px; padding: 16px 18px; }
      .timeline-card-title { font-size: 29px; }
      .timeline-card-description { font-size: 14px; line-height: 1.4; }
    }
    @media (prefers-reduced-motion: reduce) {
      .timeline-card, .timeline-card-image { transition: none !important; }
    }
  </style>
</BaseLayout>
